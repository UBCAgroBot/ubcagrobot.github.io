---
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";

const values = [
  "A student-led team building autonomous agricultural robots",
  "A respectful, inclusive space where everyone feels safe to learn",
  "A multidisciplinary community growing and creating together",
  "A welcoming environment for students of all backgrounds and experience levels",
];
---

<Section tone="tint">
  <div class="grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-1">
      <h2
        class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"
      >
        Who we are
      </h2>
      <p class="mt-3 text-lg text-slate-600">
        Here's what defines our community.
      </p>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-2">
      {
        values.map((value) => (
          <Card class="bg-white p-6 text-lg leading-snug text-slate-800 sm:p-8">
            {value}
          </Card>
        ))
      }
    </div>
  </div>
</Section>
