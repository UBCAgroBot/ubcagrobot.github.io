---
import Section from "../ui/Section.astro";
---

<Section wide>
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <img
      src="/hero-section-temp.jpg"
      alt="An AgroBot robot prototype in the team's workshop"
      class="aspect-4/3 w-full rounded-3xl object-cover lg:order-2"
    />

    <div class="lg:order-1">
      <h1
        class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl"
      >
        Technology that powers the future of agriculture
      </h1>
      <p class="mt-5 max-w-xl text-xl text-slate-600">
        Modern tools for modern farms.
      </p>
    </div>
  </div>
</Section>
