---
import Section from "../ui/Section.astro";
---

<Section tone="tint">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <img
      src="/introducing-agroponic.jpg"
      alt="Agroponics hydroponic growing system prototype"
      class="aspect-4/3 w-full rounded-3xl object-cover lg:order-2"
    />

    <div class="flex flex-col gap-6 lg:order-1">
      <h2
        class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"
      >
        Introducing Agroponics
      </h2>
      <p class="text-lg leading-relaxed text-slate-700">
        Agroponics combines IoT automation, structural engineering, and plant
        research to build optimized hydroponic environments. Through smart
        monitoring and controlled nutrient delivery, the team reduces resource
        consumption without compromising crop quality or yield.
      </p>
    </div>
  </div>
</Section>
