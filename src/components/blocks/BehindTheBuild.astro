---
import Section from "../ui/Section.astro";

const items = [
  {
    image: "/teamwork-in-motion.jpg",
    title: "Teamwork in motion",
    description:
      "Every breakthrough happens through collaboration and curiosity.",
  },
  {
    image: "/teamwork-in-motion.jpg",
    title: "Automation with purpose",
    description: "Every component serves a mission.",
  },
  {
    image: "/capturing-the-build.jpg",
    title: "Capturing the build",
    description:
      "Every moment of creation, and the joy of making something real.",
  },
];
---

<Section>
  <h2
    class="mb-12 text-center text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"
  >
    Behind the build
  </h2>

  <div class="flex flex-col gap-12">
    {
      items.map((item, index) => (
        <div
          class={`flex flex-col items-center gap-8 lg:flex-row lg:gap-12 ${index % 2 === 1 ? "lg:flex-row-reverse" : ""}`}
        >
          <img
            src={item.image}
            alt={item.title}
            class="aspect-4/3 w-full shrink-0 rounded-3xl object-cover lg:w-[420px]"
          />
          <div
            class={`flex-1 text-center lg:text-left ${index % 2 === 1 ? "lg:text-right" : ""}`}
          >
            <h3 class="mb-2 text-2xl font-semibold text-slate-900">
              {item.title}
            </h3>
            <p class="text-lg leading-relaxed text-slate-600">
              {item.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
