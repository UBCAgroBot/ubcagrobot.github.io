---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
---

<Section>
  <div class="flex flex-col items-center gap-8 text-center">
    <h2
      class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"
    >
      Get involved with Agrobot
    </h2>
    <div class="flex flex-wrap justify-center gap-4">
      <Button href="/recruitment" size="lg">Join the team</Button>
      <Button href="/sponsor" variant="secondary" size="lg">Sponsor us</Button>
    </div>
  </div>
</Section>
