---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Card from "../ui/Card.astro";

const steps = [
  {
    number: "01",
    title: "Read the website",
    description:
      "Get familiar with our team, projects, and what we are looking for before you apply.",
  },
  {
    number: "02",
    title: "Attend the info session",
    description:
      "Come meet the team, learn about the recruitment process, and ask any questions you have.",
    featured: true,
  },
  {
    number: "03",
    title: "Apply on our website",
    description:
      "Submit your application through our website once you feel ready.",
  },
];
---

<Section tone="tint">
  <SectionHeading
    eyebrow="Recruitment"
    title="How to apply"
    subtitle="A simple three-step process to get involved with Agrobot."
    align="center"
    class="mx-auto"
  />

  <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      steps.map((step) => (
        <Card
          class={`flex h-full flex-col gap-4 bg-white ${step.featured ? "ring-brand-400 ring-2" : ""}`}
        >
          <span class="bg-brand-50 text-brand-800 inline-flex h-12 w-12 items-center justify-center rounded-2xl text-sm font-semibold">
            {step.number}
          </span>
          <h3 class="text-xl font-semibold text-slate-900">{step.title}</h3>
          <p class="text-base leading-relaxed text-slate-600">
            {step.description}
          </p>
        </Card>
      ))
    }
  </div>
</Section>
