---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SubteamCard from "./SubteamCard.astro";

interface Subteam {
  id: string;
  name: string;
  icon: string;
  description: string;
  responsibilities: string[];
  teamImage: string;
}

interface TeamGroup {
  group: string;
  name: string;
  subteams: Subteam[];
}

interface Props {
  teams?: TeamGroup[];
}

const {
  teams = [
    {
      group: "agrobot-team",
      name: "Agrobot Team",
      subteams: [
        {
          id: "eletrical",
          name: "Electrical",
          icon: "electrical",
          description:
            "The Electrical Team plays a crucial role in AgroBot's success by designing, assembling, and integrating its power systems. They create detailed electrical schematics, select high-quality components, and ensure efficient power management throughout the robot. The team rigorously tests and implements quality control measures to guarantee reliable performance in all conditions. Their work ensures that AgroBot's electrical systems are robust, dependable, and capable of supporting its autonomous operations effectively.",
          responsibilities: [],
          teamImage: "/electrical-team.jpg",
        },
        {
          id: "applied-ai",
          name: "Applied AI",
          icon: "applied-ai",
          description:
            "The Applied AI sub-team pioneers the development of machine learning models and AI to tackle a variety of AgroBot's tasks, from plant identification to advanced machine vision. The team works on detecting maize and weeds, segmenting grape clusters, and integrating their models into the Robot Operating System (ROS) for real-world application. By exploring the intersection of AI research and emerging Agri-Tech, members continually push the boundaries of agricultural innovation. Their work ensures AgroBot can operate efficiently and accurately across diverse farming environments, making a tangible impact in sustainable agriculture.",
          responsibilities: [],
          teamImage: "/applied-ai-team.jpg",
        },
        {
          id: "Mechatronics",
          name: "Mechatronics",
          icon: "mechatronics",
          description:
            "The mechatronics sub-team is responsible for several projects including designing the weed targeting and elimination modules for the Agrobot and an agricultural robotic arm. We combine mechanical, electrical, and software engineering to create these systems. Currently we are working on completing our herbicide dispersion system for the latest Agrobot model as well as beginning design for a robotic arm capable of performing a wide range of agricultural related tasks such as picking fruit, testing for ripeness, and obtaining plant samples. In the future, this arm may be mounted on top of the Agrobot. We are seeking members with an interest in working within a multidisciplinary team and in enhancing their skills in either mechanical design, electrical design, or programming mechatronic systems.",
          responsibilities: [],
          teamImage: "/re-mechatronics.jpg",
        },
        {
          id: "chassis/powerTrain",
          name: "Chassis/Power Train",
          icon: "chassis-powertrain",
          description:
            "The Chassis/Powertrain sub-team designs and builds AgroBot's chassis and powertrain, ensuring smooth mobility and seamless integration of all components. They carefully select motors and power transmission systems, perform finite element analysis to guarantee safety and durability, and develop detailed design solutions. The team also assembles components from other sub-teams onto AgroBot's main body, creating a cohesive and fully functional robot. This sub-team is perfect for those interested in mechanical design, manufacturing, and bringing complex robotic systems to life.",
          responsibilities: [],
          teamImage: "/chassis-powertrain-team.jpg",
        },
        {
          id: "navigation",
          name: "Navigation",
          icon: "navigation",
          description:
            "The Navigation sub-team develops the localization, planning, and motion-control systems that allow AgroBot to travel safely and accurately in the field. The team works on multi-sensor perception, waypoint planning, obstacle avoidance, and autonomous path following to ensure the robot can navigate real agricultural environments with confidence. By integrating data from cameras, sensors, and other perception systems, the Navigation team turns raw environmental information into actionable movement decisions for the robot.",
          responsibilities: [],
          teamImage: "/re-navigation.jpg",
        },
        {
          id: "systemArchitecture",
          name: "System Architecture",
          icon: "system-architecture",
          description:
            "The System Architecture sub-team works on building deployment pipelines that bridge our custom AI models with physical robotic hardware. The team focuses on processing live camera feeds into real-time model inference workflows using tools like GStreamer and NVIDIA DeepStream. Additionally, the team takes the outputs of model inference and implement actions such as sending control signals to Arduinos and integrating bounding box data with the Navigation team. By acting as the link between software models and physical execution, their work ensures that Agrobot translates seamlessly into real-world motion and field operations.",
          responsibilities: [],
          teamImage: "/re-sys-arch.jpg",
        },
      ],
    },
    {
      group: "agroponics-team",
      name: "Agroponics Team",
      subteams: [
        {
          id: "automation",
          name: "Automation",
          icon: "automation",
          description:
            "The Automation sub-team is responsible for researching and implementing the sensing and control systems that monitor the growing environment of hydroponic systems. Their responsibilities include conducting research and documentation revision, prototyping breadboards, coding microcontrollers, and working with databases and analytics tools. The team uses tools like Arduino, Raspberry Pi, JavaScript, and Python to design and prototype circuits, calibrate sensors, send MQTT messages between devices, and build user-facing monitoring interfaces. They also work with databases and visualization tools such as Grafana to support data-driven system design and monitoring.",
          responsibilities: [],
          teamImage: "/re-automation.jpg",
        },
        {
          id: "plants",
          name: "Plants",
          icon: "plants",
          description:
            "The Plants subteam manages the logistics and design of hydroponic systems, with a strong emphasis on research. Members utilize their creativity to design experiments and develop innovative methods for growing nutritionally relevant crops without soil or sunlight. The team focuses on designing hydroponic systems, optimizing them through data collection, and collaborating with other subteams to ensure compatibility of design. Their work supports more advanced, scalable crop production methods through analytical chemistry and rigorous experimental design.",
          responsibilities: [],
          teamImage: "/re-plants.jpg",
        },
        {
          id: "structure",
          name: "Structure",
          icon: "structure",
          description:
            "The Structure sub-team designs and builds optimal growing environments by renovating and equipping spaces for hydroponic systems. They plan the layout and interior elements of the trailer, design and simulate structural components, create hydroponic structures, and renovate the trailer using hands-on skills. Their work combines practical construction skills with CAD-based planning to create functional, efficient growing environments for AgroPonics systems.",
          responsibilities: [],
          teamImage: "/re-structure.jpg",
        },
      ],
    },
    {
      group: "administration-team",
      name: "Administration Team",
      subteams: [
        {
          id: "web-dev",
          name: "Web Development",
          icon: "web-dev",
          description:
            "The Web Development sub-team builds and maintains AgroBot’s digital platforms, from the public-facing website to internal tools, databases, and dashboards. We design self-hosted services using Docker, VMs, and Kubernetes, develop secure backend systems with Supabase, and create dashboards for observability and monitoring of systems, services, and hardware. Members work on modern frontend and backend systems using React, Astro, TypeScript, Figma, PostgreSQL, and infrastructure tools to support the team’s digital ecosystem.",
          responsibilities: [],
          teamImage: "/re-webdev.jpg",
        },
        {
          id: "agriculturalResearch",
          name: "Agricultural Research",
          icon: "agricultural-research",
          description:
            "The Agricultural Research sub-team provides critical agricultural knowledge and conducts research to support the development of AgroBot and AgroPonics, ensuring our projects are informed by the latest advancements in the field. The team conducts agricultural research, provides domain-specific expertise, reaches out to industry professionals and experts, and collaborates with other sub-teams to ensure agricultural accuracy and relevance in all projects. This work helps integrate real-world agricultural knowledge into innovative technical solutions.",
          responsibilities: [],
          teamImage: "/re-research.jpg",
        },
        {
          id: "finance",
          name: "Finance",
          icon: "finance",
          description:
            "The Finance sub-team manages our financial resources, ensures budgetary compliance, and secures funding to support our projects and operations. The team is responsible for managing budgets, expenses, and financial records; developing financial plans and strategies; securing funding and sponsorships; and collaborating with other sub-teams to allocate resources effectively. Their work helps keep the organization sustainable and well-supported as it grows.",
          responsibilities: [],
          teamImage: "/re-finance.jpg",
        },
        {
          id: "marketing",
          name: "Marketing",
          icon: "marketing",
          description:
            "The Marketing sub-team manages UBC Agrobot’s public image and online presence, creates engaging content, and promotes our projects and initiatives to the public. The team develops visual and written content for social media and website channels, builds strategic marketing plans, maintains branding across platforms, and engages with the community to build relationships with potential sponsors. Their work helps communicate our mission and highlight the impact of each team’s efforts.",
          responsibilities: [],
          teamImage: "/re-marketing.jpg",
        },
        {
          id: "outreach",
          name: "Outreach",
          icon: "outreach",
          description:
            "The Outreach sub-team manages all of UBC Agrobot’s corporate relations with relevant organizations, whether it be for partnerships, sponsorships, or other collaborations. The team researches potential agricultural partners, drafts and sends outreach messages through LinkedIn and email, builds relationships with companies in the agricultural sector, and coordinates community and corporate events to foster professional partnerships. Through strategic relationship-building, they help expand Agrobot’s network and create opportunities for collaboration and sponsorship.",
          responsibilities: [],
          teamImage: "/re-outreach.jpg",
        },
      ],
    },
  ],
} = Astro.props;
---

<Section tone="tint">
  <SectionHeading
    title="Learn about our subteams"
    align="center"
    class="mx-auto"
  />

  <div class="mt-12 flex flex-col gap-10">
    {
      teams.map((group) => (
        <div class="rounded-3xl bg-white p-6 ring-1 ring-slate-900/5 sm:p-10">
          <h3 class="mb-8 text-center text-2xl font-semibold text-slate-900">
            {group.name}
          </h3>

          <div class="flex flex-wrap justify-center gap-8">
            {group.subteams.map((team) => (
              <SubteamCard
                id={team.id}
                name={team.name}
                icon={team.icon}
                description={team.description}
                responsibilities={team.responsibilities}
                teamImage={team.teamImage}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
