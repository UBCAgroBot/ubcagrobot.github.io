---
import Card from "../ui/Card.astro";

interface Props {
  quote: string;
  author: string;
}

const { quote, author } = Astro.props;
---

<Card as="figure" class="flex h-full flex-col justify-between gap-8 bg-white">
  <blockquote class="text-lg leading-relaxed text-slate-700">
    "{quote}"
  </blockquote>
  <figcaption class="text-base font-medium text-slate-500">
    &mdash; {author}
  </figcaption>
</Card>
