---
import Section from "../ui/Section.astro";
---

<Section wide>
  <div class="flex flex-col items-center gap-2 text-center">
    <h2
      class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl"
    >
      A closer look at Agrobot
    </h2>
    <p class="max-w-2xl text-lg text-slate-600">
      From design to deployment, here's what life inside Agrobot looks like.
    </p>
  </div>

  <img
    src="/leadership-meeting.jpg"
    alt="Agrobot team members in a planning meeting"
    class="mt-8 h-[260px] w-full rounded-3xl object-cover object-[50%_60%] sm:h-[340px] lg:h-[406px]"
  />
</Section>
