---
import TeamModal from "./TeamModal.astro";
import TeamIcon from "../icons/TeamIcon.astro";

interface Props {
  id: string;
  name: string;
  icon: string;
  description: string;
  responsibilities: string[];
  teamImage: string;
}

const { id, name, icon, description, responsibilities, teamImage } =
  Astro.props;
---

<div class="flex flex-col items-center">
  <button
    type="button"
    class="group flex flex-col items-center gap-2 rounded-2xl"
    onclick={`document.getElementById('${id}').showModal()`}
  >
    <span
      class="flex h-24 w-24 items-center justify-center rounded-2xl bg-slate-50 text-blue-700 shadow-sm ring-1 ring-slate-200 transition-transform group-hover:scale-105"
    >
      <TeamIcon name={icon} class="h-11 w-11" />
    </span>
    <p class="text-sm font-medium text-slate-800">{name}</p>
  </button>

  <TeamModal
    id={id}
    name={name}
    description={description}
    responsibilities={responsibilities}
    teamImage={teamImage}
  />
</div>
