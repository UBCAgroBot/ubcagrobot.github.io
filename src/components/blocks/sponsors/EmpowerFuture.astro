---
import Section from "../../ui/Section.astro";
import Button from "../../ui/Button.astro";
---

<Section tone="brand">
  <div class="flex flex-col items-center gap-8 text-center">
    <div class="flex flex-col items-center gap-4">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Empower the future of agricultural robotics
      </h2>
      <p class="text-brand-100 max-w-xl text-lg leading-relaxed">
        You help turn ideas into reality, and we can't thank you enough.
      </p>
    </div>

    <Button href="mailto:ubcagrobot@gmail.com" variant="outline" size="lg"
      >Sponsor us</Button
    >
  </div>
</Section>
