---
import Section from "../../ui/Section.astro";
import SectionHeading from "../../ui/SectionHeading.astro";

// No sponsor logos have been provided yet -- these tiles hold the layout
// until real partner logos are added.
const partnerSlots = 5;
---

<Section tone="tint">
  <SectionHeading title="Our valued partners" align="center" class="mx-auto" />

  <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
    {
      Array.from({ length: partnerSlots }).map(() => (
        <div class="flex aspect-square items-center justify-center rounded-3xl bg-white ring-1 ring-slate-900/5">
          <span class="text-xs font-medium text-slate-400">
            Logo coming soon
          </span>
        </div>
      ))
    }
  </div>
</Section>
