---
import FallbackImage from "../ui/FallbackImage.astro";
import SectionHeading from "../ui/SectionHeading.astro";

// Only real, named leads are listed here -- no placeholder entries.
// Add teammates as their headshot + LinkedIn become available.
const leads = [
  {
    name: "Lisa Chen",
    img: "/headshots/lisa_chen_headshot.jpeg",
    role: "Web Dev Lead",
    linkedin: "https://www.linkedin.com/in/lisac777/",
  },
  {
    name: "Salhajvir Kalkat",
    img: "",
    role: "Captain",
    linkedin: "https://www.linkedin.com/in/saihajvir/",
  },
  {
    name: "Ishaan Datta",
    img: "",
    role: "Applied AI Lead",
    linkedin: "https://www.linkedin.com/in/ishaan-datta/",
  },
];

const scrollingLeads = [...leads, ...leads];
---

<section class="bg-slate-50 py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading title="Meet the leads" align="center" class="mx-auto" />

    <div class="relative mt-10">
      <div
        id="meet-the-leads-carousel"
        class="no-scrollbar -mt-2 flex cursor-grab gap-6 overflow-x-auto px-2 pt-2 pb-4 active:cursor-grabbing"
      >
        {
          scrollingLeads.map((lead, index) => (
            <article
              class="group shrink-0 text-center"
              aria-label={`${lead.name}, ${lead.role}`}
            >
              <a
                href={lead.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="lead-link block"
                aria-label={`View ${lead.name}'s LinkedIn profile`}
              >
                <FallbackImage
                  src={lead.img}
                  alt={lead.name}
                  loading={index < leads.length ? "eager" : "lazy"}
                  class="h-32 w-32 rounded-[28px] shadow-sm transition duration-300 group-hover:-translate-y-1 group-hover:shadow-md sm:h-36 sm:w-36 md:h-40 md:w-40"
                />
              </a>

              <div class="mt-3">
                <p class="text-sm font-medium text-slate-900">{lead.name}</p>
                <p class="text-xs text-slate-500">{lead.role}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div
        class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-slate-50 to-transparent"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-slate-50 to-transparent"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const carousel = document.getElementById("meet-the-leads-carousel");

  if (carousel) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let autoScrollPausedUntil = 0;
    let dragged = false;

    const pauseAutoScroll = (ms = 800) => {
      autoScrollPausedUntil = Date.now() + ms;
    };

    const getLoopPoint = () => carousel.scrollWidth / 2;

    const normalizeScroll = () => {
      const loopPoint = getLoopPoint();

      if (carousel.scrollLeft >= loopPoint) {
        carousel.scrollLeft -= loopPoint;
      } else if (carousel.scrollLeft < 0) {
        carousel.scrollLeft += loopPoint;
      }
    };

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const autoScroll = () => {
      if (!isDown && Date.now() >= autoScrollPausedUntil) {
        carousel.scrollLeft += 0.35;
        normalizeScroll();
      }

      requestAnimationFrame(autoScroll);
    };

    if (!reduceMotion) {
      requestAnimationFrame(autoScroll);
    }

    carousel.addEventListener("mousedown", (e) => {
      isDown = true;
      dragged = false;
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });

    carousel.addEventListener("mouseleave", () => {
      if (isDown) {
        isDown = false;
        pauseAutoScroll(600);
        normalizeScroll();
      }
    });

    carousel.addEventListener("mouseup", () => {
      if (isDown) {
        isDown = false;
        pauseAutoScroll(600);
        normalizeScroll();
      }
    });

    carousel.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();

      const x = e.pageX - carousel.offsetLeft;
      const walk = x - startX;

      if (Math.abs(walk) > 5) {
        dragged = true;
      }

      carousel.scrollLeft = scrollLeft - walk * 1.2;
      normalizeScroll();
    });

    carousel.addEventListener(
      "touchstart",
      () => {
        pauseAutoScroll(800);
      },
      { passive: true },
    );

    carousel.addEventListener(
      "touchmove",
      () => {
        normalizeScroll();
      },
      { passive: true },
    );

    carousel.addEventListener(
      "wheel",
      () => {
        pauseAutoScroll(500);
        requestAnimationFrame(normalizeScroll);
      },
      { passive: true },
    );

    carousel.querySelectorAll(".lead-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (dragged) {
          e.preventDefault();
          dragged = false;
        }
      });
    });
  }
</script>
