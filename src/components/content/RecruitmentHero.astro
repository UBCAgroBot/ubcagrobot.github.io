---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Join our team",
  subtitle = "Applications are open right now!",
} = Astro.props;
const applicationUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSe8e8fSpGi4zjgt4dQtpgwgpeIF6I8e-85_scdc6rLb6sUBGA/viewform?usp=publish-editor";
---

<section
  class="relative flex min-h-[70vh] w-full items-center justify-center bg-cover bg-center px-6 py-24 text-white sm:min-h-[80vh]"
  style="background-image: url('/recruitment-hero.jpg');"
>
  <div class="absolute inset-0 bg-slate-950/55" aria-hidden="true"></div>

  <div class="relative z-10 max-w-3xl text-center">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">
      {title}
    </h1>

    <p class="mt-5 text-xl text-slate-100 sm:text-2xl">
      {subtitle}
    </p>

    <a
      href={applicationUrl}
      target="_blank"
      rel="noreferrer"
      class="mt-6 inline-block rounded-full bg-emerald-500 px-6 py-3 text-base font-semibold text-white transition hover:bg-emerald-400 focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-slate-950 focus:outline-none sm:text-lg"
    >
      Apply now
    </a>
  </div>
</section>
