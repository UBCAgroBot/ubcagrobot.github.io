---
// Cohesive icon set for team/subteam cards. All icons share a 24x24 grid,
// 1.6 stroke weight, rounded caps/joins, and currentColor so callers control
// color via CSS. Add new icons here rather than importing raster images.
const icons: Record<string, string> = {
  electrical: `<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="7.3" cy="7.3" r="0.9" fill="currentColor" stroke="none"/><circle cx="16.7" cy="16.7" r="0.9" fill="currentColor" stroke="none"/><path d="M7.3 7.3 9 9"/><path d="M16.7 16.7 15 15"/><path d="M13.4 7.2 10.2 12.6 12.7 12.6 10.9 17 15.5 10.8 12.9 10.8 Z"/>`,
  "applied-ai": `<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9.5 7 9.5 4.3 M14.5 7 14.5 4.3 M9.5 17 9.5 19.7 M14.5 17 14.5 19.7 M7 9.5 4.3 9.5 M7 14.5 4.3 14.5 M17 9.5 19.7 9.5 M17 14.5 19.7 14.5"/><path d="M9.7 10.3 14.3 10.3 M9.7 10.3 12 15 M14.3 10.3 12 15"/><circle cx="9.7" cy="10.3" r="0.75" fill="currentColor" stroke="none"/><circle cx="14.3" cy="10.3" r="0.75" fill="currentColor" stroke="none"/><circle cx="12" cy="15" r="0.75" fill="currentColor" stroke="none"/>`,
  mechatronics: `<circle cx="9" cy="9" r="3.1"/><path d="M9 4.4 9 5.9 M9 12.1 9 13.6 M4.4 9 5.9 9 M12.1 9 13.6 9 M6.1 6.1 7.2 7.2 M10.8 10.8 11.9 11.9 M6.1 11.9 7.2 10.8 M10.8 7.2 11.9 6.1"/><rect x="13" y="13" width="6.6" height="4.6" rx="1"/><path d="M11.6 12 13.4 13.9"/><path d="M15 13 15 11.3 M17.6 13 17.6 11.3 M15 17.6 15 19.3 M17.6 17.6 17.6 19.3"/>`,
  "chassis-powertrain": `<circle cx="7.6" cy="13" r="4.6"/><circle cx="7.6" cy="13" r="1" fill="currentColor" stroke="none"/><path d="M7.6 8.4 7.6 12 M7.6 14 7.6 17.6 M3 13 6.6 13 M8.6 13 12.2 13"/><path d="M12.9 13 15.6 13"/><circle cx="17.7" cy="13" r="2.3"/><path d="M17.7 10 17.7 11.1 M17.7 14.9 17.7 16 M14.7 13 15.8 13 M19.6 13 20.7 13 M15.8 11.1 16.5 11.8 M18.9 14.2 19.6 14.9 M15.8 14.9 16.5 14.2 M18.9 11.8 19.6 11.1"/>`,
  navigation: `<circle cx="12" cy="12" r="8"/><path d="M15.5 8.5 10.8 10.8 8.5 15.5 13.2 13.2 Z"/><circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"/>`,
  "system-architecture": `<rect x="9.3" y="4" width="5.4" height="4.4" rx="1.1"/><rect x="3.6" y="15.6" width="5.4" height="4.4" rx="1.1"/><rect x="15" y="15.6" width="5.4" height="4.4" rx="1.1"/><path d="M12 8.4 12 12 M12 12 6.3 12 6.3 15.6 M12 12 17.7 12 17.7 15.6"/>`,
  automation: `<rect x="8.7" y="18" width="6.6" height="2.2" rx="0.9"/><path d="M12 18 12 14.2"/><circle cx="12" cy="14.2" r="1" fill="currentColor" stroke="none"/><path d="M12 14.2 16.3 10.2"/><circle cx="16.3" cy="10.2" r="1" fill="currentColor" stroke="none"/><path d="M16.3 10.2 18.8 8 M16.3 10.2 18.6 11.6"/>`,
  plants: `<path d="M12 20 12 10.5"/><path d="M12 10.5 C12 7.2 14.4 4.8 18.2 4.3 18.7 8.1 16.3 10.5 12 10.5 Z"/><path d="M12 10.5 C12 7.6 9.9 5.4 6.2 5 5.8 8.4 7.9 10.5 12 10.5 Z"/><path d="M9 20 15 20"/>`,
  structure: `<path d="M4 19 4 11 12 5 20 11 20 19"/><path d="M4 19 20 19"/><path d="M8 11 8 19 M16 11 16 19 M12 8.3 12 19"/><path d="M4 15 20 15"/>`,
  "web-dev": `<rect x="3.5" y="5" width="17" height="14" rx="2.2"/><path d="M3.5 9 20.5 9"/><circle cx="6.2" cy="7" r="0.6" fill="currentColor" stroke="none"/><path d="M9.5 13 7.3 15 9.5 17 M14.5 13 16.7 15 14.5 17"/>`,
  "agricultural-research": `<path d="M10 4 14 4 M10.7 4 10.7 9.5 6.5 17.5 C6.1 18.3 6.7 19.5 8 19.5 L16 19.5 C17.3 19.5 17.9 18.3 17.5 17.5 L13.3 9.5 13.3 4"/><path d="M8.5 15 C9 13 10.6 12.5 12 13 C11.6 14.6 10.2 15.4 8.5 15 Z" fill="currentColor" stroke="none"/>`,
  finance: `<path d="M4 20 20 20"/><rect x="6" y="13" width="3.2" height="7"/><rect x="10.4" y="9" width="3.2" height="11"/><rect x="14.8" y="5.5" width="3.2" height="14.5"/><path d="M6 8.5 10 5.5 13.5 7.5 18 4"/><path d="M15 4 18 4 18 7"/>`,
  marketing: `<path d="M4 10 4 14 7 14 13 18 13 6 7 10 Z"/><path d="M13 8.5 C14.7 9.4 14.7 14.6 13 15.5"/><path d="M16 7 C18.8 8.7 18.8 15.3 16 17"/><path d="M5.5 14 6.3 18"/>`,
  outreach: `<circle cx="8" cy="8.5" r="2.6"/><path d="M3.5 19 C3.5 15.3 5.4 13.3 8 13.3 C10.6 13.3 12.5 15.3 12.5 19"/><circle cx="17" cy="9.5" r="2.2"/><path d="M13.3 18 C13.3 15 15 13.2 17 13.2 C19.2 13.2 20.7 14.9 20.7 17.6"/><path d="M10.4 9 14.8 9.5"/>`,
};

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "h-10 w-10" } = Astro.props;
const inner = icons[name];

if (import.meta.env.DEV && !inner) {
  throw new Error(`TeamIcon: unknown icon name "${name}"`);
}
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={inner}
/>
