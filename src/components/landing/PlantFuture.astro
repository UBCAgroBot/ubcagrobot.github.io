---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
---

<Section>
  <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
    <h2
      class="mb-6 text-4xl font-semibold tracking-tight text-slate-900 md:text-5xl"
    >
      Plant your future here
    </h2>

    <div class="mb-8">
      <Button href="/recruitment" variant="secondary">Join our team</Button>
    </div>

    <div class="w-full overflow-hidden rounded-3xl">
      <img
        src="/group-of-people-smiling.jpg"
        alt="Agrobot team members working together"
        class="h-[260px] w-full object-cover md:h-[360px]"
      />
    </div>
  </div>
</Section>
