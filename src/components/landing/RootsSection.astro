---
import agrobotStudentsWorkingLanding from "../../assets/images/agrobot-students-working-landing.jpg";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
---

<Section>
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <div class="text-center lg:text-left">
      <h2
        class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl"
      >
        How Agrobot took root
      </h2>

      <p
        class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-600 lg:mx-0"
      >
        UBC Agrobot began as a student initiative to bring robotics into
        agriculture. Now, we design practical solutions for modern farming.
      </p>

      <div class="mt-7">
        <Button href="/about" variant="secondary">Learn more</Button>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <img
        src={agrobotStudentsWorkingLanding.src}
        alt="UBC Agrobot students collaborating on a robotics project"
        class="h-[300px] w-full max-w-[440px] rounded-3xl object-cover shadow-sm sm:h-[320px]"
      />
    </div>
  </div>
</Section>
