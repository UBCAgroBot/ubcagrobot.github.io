---
const year = new Date().getFullYear();

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Recruitment", href: "/recruitment" },
  { label: "Sponsor Us", href: "/sponsor" },
  { label: "Newsletter", href: "/newsletter" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="w-full border-t border-slate-900/10 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="flex flex-col gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-3"
          aria-label="UBC Agrobot Home"
        >
          <img
            src="/agrobot_logo.png"
            alt="UBC Agrobot logo"
            class="h-8 w-8 object-contain"
          />
          <span class="text-lg font-semibold text-slate-900">UBC Agrobot</span>
        </a>

        <p class="max-w-xs text-sm leading-relaxed text-slate-600">
          A UBC student engineering team building autonomous robots and
          agroponics systems for sustainable agriculture.
        </p>

        <div class="flex items-center gap-3">
          <a
            href="https://www.linkedin.com/company/ubcagrobot/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="UBC Agrobot on LinkedIn"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-900"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 1 1 0-4.122 2.06 2.06 0 0 1 0 4.122zM7.114 20.452H3.56V9h3.554v11.452z"
              ></path>
            </svg>
          </a>
          <a
            href="https://instagram.com/ubcagrobot"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="UBC Agrobot on Instagram"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-900"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>

      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-x-8 gap-y-2 sm:flex sm:flex-col"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-2 text-sm text-slate-600">
        <p class="font-semibold text-slate-900">Contact</p>
        <a
          href="mailto:ubcagrobot@gmail.com"
          class="underline-offset-2 hover:text-slate-900 hover:underline"
        >
          ubcagrobot@gmail.com
        </a>
        <p>Vancouver, BC, Canada</p>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-900/10 pt-6 text-sm text-slate-500">
      <p>&copy; {year} UBC Agrobot. All rights reserved.</p>
    </div>
  </div>
</footer>
