---
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Recruitment", href: "/recruitment" },
  { label: "Sponsor Us", href: "/sponsor" },
  { label: "Newsletter", href: "/newsletter" },
  { label: "Contact", href: "/contact" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-slate-900/10 bg-white/95 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4"
  >
    <a
      href="/"
      aria-label="UBC Agrobot Home"
      class="inline-flex items-center gap-3 whitespace-nowrap"
    >
      <img
        src="/agrobot_logo.png"
        alt="UBC Agrobot logo"
        class="block h-8 w-auto object-contain"
      />
      <span class="text-lg font-semibold tracking-tight text-slate-900"
        >UBC Agrobot</span
      >
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class={`inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-medium transition-colors ${
                  isActive(link.href)
                    ? "bg-brand-50 text-brand-800"
                    : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile menu toggle -->
    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center rounded-full p-2 text-slate-700 hover:bg-slate-100 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <svg
        id="nav-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
      </svg>
      <svg
        id="nav-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile navigation -->
  <nav
    id="mobile-nav"
    aria-label="Primary"
    class="hidden border-t border-slate-900/10 lg:hidden"
  >
    <ul class="flex flex-col gap-1 px-4 py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={`block rounded-xl px-4 py-3 text-base font-medium ${
                isActive(link.href)
                  ? "bg-brand-50 text-brand-800"
                  : "text-slate-700 hover:bg-slate-100"
              }`}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Keep --header-height in sync with the header's real rendered height,
  // since it varies with font loading, zoom, and viewport width.
  const header = document.querySelector("header");

  if (header) {
    const setHeaderHeight = () => {
      document.documentElement.style.setProperty(
        "--header-height",
        `${header.offsetHeight}px`,
      );
    };
    setHeaderHeight();
    new ResizeObserver(setHeaderHeight).observe(header);
  }

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden", isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });

  // Collapse the mobile menu automatically when navigating to a link.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      menu.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    });
  });
</script>
