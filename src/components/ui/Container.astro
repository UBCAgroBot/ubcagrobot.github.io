---
/*
Consistent content width + horizontal gutter used across every page.
Pass `wide` for the occasional full-bleed-ish section (e.g. image banners).
*/
interface Props {
  wide?: boolean;
  class?: string;
}

const { wide = false, class: className = "" } = Astro.props;
---

<div
  class={`mx-auto w-full px-6 ${wide ? "max-w-7xl" : "max-w-6xl"} ${className}`}
>
  <slot />
</div>
