---
/*
Drop-in replacement for <img> that degrades gracefully instead of showing a
broken-image icon when a source is missing (several team/subteam photos in
this project don't exist yet). On error, the <img> is hidden and a neutral
sprout icon tile takes its place -- never a fabricated stock photo.
*/
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const { src, alt, class: className = "", loading = "lazy" } = Astro.props;
---

<span
  class={`relative block overflow-hidden bg-slate-100 ${className}`}
  data-fallback-image
>
  {
    src && (
      <img
        src={src}
        alt={alt}
        loading={loading}
        class="h-full w-full object-cover"
      />
    )
  }
  <span
    hidden={Boolean(src)}
    class="absolute inset-0 flex items-center justify-center text-slate-300"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      class="h-10 w-10"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 21V10m0 0c0-3.5 2.5-6 6.5-6.5C18 7.5 15.5 10 12 10Zm0 0C12 6.5 9.5 4 5.5 3.5 6 7.5 8.5 10 12 10Z"
      ></path>
    </svg>
  </span>
</span>

<script>
  // `error` events don't bubble, but they can be caught in the capture phase,
  // so one listener handles every FallbackImage instance on the page.
  document.addEventListener(
    "error",
    (event) => {
      const img = event.target;
      if (!(img instanceof HTMLImageElement)) return;

      const wrapper = img.closest("[data-fallback-image]");
      const fallback = wrapper?.querySelector("span[hidden]");
      if (!fallback) return;

      img.style.display = "none";
      fallback.removeAttribute("hidden");
    },
    true,
  );
</script>
