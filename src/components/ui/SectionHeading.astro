---
/*
Eyebrow + title + subtitle pattern repeated across nearly every section.
*/
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  invert?: boolean;
  /** Use "h1" when this is the primary heading for the page. Defaults to "h2". */
  level?: "h1" | "h2";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "left",
  invert = false,
  level: Heading = "h2",
  class: className = "",
} = Astro.props;
---

<div
  class={`max-w-2xl ${align === "center" ? "mx-auto text-center" : ""} ${className}`}
>
  {
    eyebrow && (
      <p
        class={`text-sm font-semibold tracking-wide uppercase ${invert ? "text-brand-300" : "text-brand-700"}`}
      >
        {eyebrow}
      </p>
    )
  }
  <Heading
    class={`text-3xl font-semibold tracking-tight sm:text-4xl ${eyebrow ? "mt-2" : ""} ${invert ? "text-white" : "text-slate-900"}`}
  >
    {title}
  </Heading>
  {
    subtitle && (
      <p
        class={`mt-4 text-lg leading-relaxed ${invert ? "text-slate-200" : "text-slate-600"}`}
      >
        {subtitle}
      </p>
    )
  }
</div>
