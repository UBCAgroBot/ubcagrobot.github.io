---
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "UBC Agrobot",
  description = "UBC Agrobot is a UBC student engineering team designing and building autonomous robots and agroponics systems for sustainable agriculture.",
} = Astro.props;

const pageTitle = title === "UBC Agrobot" ? title : `${title} | UBC Agrobot`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/agrobot_logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    border-radius: 0.5rem;
    background: white;
    padding: 0.5rem 1rem;
    font-weight: 600;
    color: var(--color-brand-800);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.15);
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
